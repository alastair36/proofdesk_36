{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{templates/**,static/**,schema.sql,utils/**,routes/**,*.py}"
    }
  }
}
